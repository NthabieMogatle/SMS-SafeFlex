# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit secrets.

# --- Supabase ---
# Get these from your Supabase project: Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# --- Anthropic (Claude API) ---
# Get from https://console.anthropic.com/settings/keys
# Server-side only — do NOT prefix with NEXT_PUBLIC_
ANTHROPIC_API_KEY=sk-ant-your-key-here

# --- App ---
# Used for Supabase email redirect links in dev
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Admin ---
# Required to view /admin/health (visit /admin/health?key=THIS_VALUE).
# Pick a long random string. Without this set, /admin/health returns 404.
ADMIN_SECRET=pick-a-long-random-string

# --- AppSumo webhook ---
# Shared secret AppSumo uses to sign webhook payloads (HMAC-SHA256).
# Configure in your AppSumo vendor dashboard, paste the same value here.
# Without this set, /api/webhooks/appsumo returns 503.
APPSUMO_WEBHOOK_SECRET=

# --- Gumroad webhook ---
# Used by /api/webhooks/gumroad to (a) cheaply scope inbound pings to
# our own seller account and (b) verify license keys against Gumroad's
# /v2/licenses/verify API before minting a redemption code.
# Set BOTH in Vercel (Production + Preview) before pointing Gumroad's
# Ping URL at the deployed route. Without them set, the route logs a
# warning and 200-acks the ping without minting.
# GUMROAD_SELLER_ID: from https://app.gumroad.com/settings/advanced
#   ("Seller ID" — a short alphanumeric string).
# GUMROAD_PRODUCT_ID: from the product's edit page URL, or via the
#   Gumroad API. NOT the permalink — that's "fftsf" and is hardcoded
#   in the route.
GUMROAD_SELLER_ID=
GUMROAD_PRODUCT_ID=

# --- Supabase service role ---
# Server-side only. Used by the AppSumo webhook to insert redemption codes
# and revoke plan tiers without going through user auth. Keep this SECRET —
# it bypasses RLS. Get it from Supabase Settings -> API -> service_role.
SUPABASE_SERVICE_ROLE_KEY=
